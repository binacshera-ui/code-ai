{
  "name": "code-ai",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --outfile=dist/server.js --format=esm --external:express --external:multer --external:cors --external:express-session --external:connect-pg-simple --external:pg --external:node-pty --external:ws && node scripts/copy-personal-chrome-runtime.mjs",
    "test:workbench:runtime": "rm -rf /tmp/code-ai-workbench-runtime-smoke && esbuild scripts/workbench-rebind-smoke.ts --bundle --platform=node --format=esm --outfile=/tmp/code-ai-workbench-rebind-smoke.mjs && CODEX_STORAGE_ROOT=/tmp/code-ai-workbench-runtime-smoke node --env-file=.env /tmp/code-ai-workbench-rebind-smoke.mjs",
    "test:session-routes": "esbuild scripts/session-route-smoke.ts --bundle --platform=node --format=esm --outfile=/tmp/code-ai-session-route-smoke.mjs && node --test /tmp/code-ai-session-route-smoke.mjs",
    "test:session-route-url": "esbuild client/src/sessionRoute.test.ts --bundle --platform=node --format=esm --outfile=/tmp/code-ai-session-route-url.test.mjs && node --test /tmp/code-ai-session-route-url.test.mjs",
    "test:session-realtime": "session_live_root=$(mktemp -d /tmp/code-ai-session-live-build-XXXXXX) && esbuild server/codexSessionRealtime.test.ts --bundle --platform=node --format=esm --outfile=$session_live_root/test.mjs --external:node-pty && node --test $session_live_root/test.mjs",
    "test:session-transport": "session_transport_root=$(mktemp -d /tmp/code-ai-session-transport-XXXXXX) && esbuild server/codexSessionTransport.test.ts --bundle --platform=node --format=esm --outfile=$session_transport_root/test.mjs && node --test $session_transport_root/test.mjs",
    "test:timeline-presentation": "esbuild client/src/components/codex/timelinePresentation.test.ts --bundle --platform=node --format=esm --outfile=/tmp/code-ai-timeline-presentation.test.mjs && node --test /tmp/code-ai-timeline-presentation.test.mjs",
    "test:queue-completion-toast": "queue_toast_test_root=$(mktemp -d /tmp/code-ai-queue-toast-XXXXXX) && esbuild client/src/components/codex/queueCompletionToast.test.ts --bundle --platform=node --format=esm --outfile=$queue_toast_test_root/test.mjs && node --test $queue_toast_test_root/test.mjs",
    "test:session-workspaces": "session_workspace_test_root=$(mktemp -d /tmp/code-ai-session-workspaces-XXXXXX) && esbuild server/codexSessionWorkspaces.test.ts --bundle --platform=node --format=esm --outfile=$session_workspace_test_root/test.mjs && CODEX_STORAGE_ROOT=$session_workspace_test_root node --test $session_workspace_test_root/test.mjs",
    "test:workspace-move-selection": "workspace_move_selection_root=$(mktemp -d /tmp/code-ai-workspace-move-selection-XXXXXX) && esbuild client/src/components/codex/workspaceMoveSelection.test.ts --bundle --platform=node --format=esm --outfile=$workspace_move_selection_root/test.mjs && node --test $workspace_move_selection_root/test.mjs",
    "test:transcript-scroll": "transcript_scroll_test_root=$(mktemp -d /tmp/code-ai-transcript-scroll-XXXXXX) && esbuild client/src/components/codex/transcriptScrollPolicy.test.ts --bundle --platform=node --format=esm --outfile=$transcript_scroll_test_root/test.mjs && node --test $transcript_scroll_test_root/test.mjs",
    "test:account-usage": "account_usage_test_root=$(mktemp -d /mnt/hdd/code-ai-builds/account-usage-test-XXXXXX) && trap 'find \"$account_usage_test_root\" -depth -delete' EXIT && esbuild server/codexAccountUsage.test.ts --bundle --platform=node --format=esm --outfile=$account_usage_test_root/test.mjs && node --test $account_usage_test_root/test.mjs",
    "test:account-auth": "account_auth_test_root=$(mktemp -d /mnt/hdd/code-ai-builds/account-auth-test-XXXXXX) && trap 'find \"$account_auth_test_root\" -depth -delete' EXIT && esbuild server/codexAccountAuth.test.ts --bundle --platform=node --format=esm --outfile=$account_auth_test_root/test.mjs && node --test $account_auth_test_root/test.mjs",
    "test:usage-panel-position": "usage_panel_test_root=$(mktemp -d /mnt/hdd/code-ai-builds/usage-panel-test-XXXXXX) && trap 'find \"$usage_panel_test_root\" -depth -delete' EXIT && esbuild client/src/components/codex/usagePanelPosition.test.ts --bundle --platform=node --format=esm --outfile=$usage_panel_test_root/test.mjs && node --test $usage_panel_test_root/test.mjs",
    "cache:prewarm-sessions": "esbuild scripts/prewarm-session-cache.ts --bundle --platform=node --format=esm --outfile=/tmp/code-ai-prewarm-session-cache.mjs --external:node-pty && node --env-file=.env /tmp/code-ai-prewarm-session-cache.mjs",
    "test:workbench:sso": "esbuild scripts/bina-sso-smoke.ts --bundle --platform=node --format=esm --outfile=/tmp/code-ai-bina-sso-smoke.mjs && node /tmp/code-ai-bina-sso-smoke.mjs",
    "test:workbench:sso:e2e": ".venv/bin/python scripts/bina-runtime-sso-e2e.py",
    "test:workbench:visual:e2e": ".venv/bin/python scripts/workbench-visual-e2e.py",
    "test:workbench:parallel-tabs:e2e": ".venv/bin/python scripts/workbench-parallel-tabs-e2e.py",
    "test:browser-mode": "esbuild server/codexBrowserMode.test.ts --bundle --platform=node --format=esm --outfile=/tmp/code-ai-codex-browser-mode.test.mjs && node --test /tmp/code-ai-codex-browser-mode.test.mjs",
    "test:design-mode": "design_test_root=$(mktemp -d /tmp/code-ai-design-mode-test-XXXXXX) && esbuild server/codexDesignMode.test.ts --bundle --platform=node --format=esm --outfile=/tmp/code-ai-codex-design-mode.test.mjs && CODEX_APP_ROOT=$PWD CODEX_STORAGE_ROOT=$design_test_root node --test /tmp/code-ai-codex-design-mode.test.mjs",
    "test:gemini-process-env": "esbuild server/geminiProcessEnv.test.ts --bundle --platform=node --format=esm --outfile=/tmp/code-ai-gemini-process-env.test.mjs && node --test /tmp/code-ai-gemini-process-env.test.mjs",
    "test:design-mode:visual": ".venv/bin/python scripts/design-mode-visual-e2e.py",
    "test:design-mode:gemini": "esbuild scripts/design-mode-gemini-smoke.ts --bundle --platform=node --format=esm --outfile=/tmp/code-ai-design-mode-gemini-smoke.mjs && CODEX_APP_ROOT=$PWD node /tmp/code-ai-design-mode-gemini-smoke.mjs",
    "test:ux-mode": "ux_test_root=$(mktemp -d /tmp/code-ai-ux-mode-test-XXXXXX) && esbuild server/codexUxMode.test.ts --bundle --platform=node --format=esm --outfile=/tmp/code-ai-codex-ux-mode.test.mjs && CODEX_APP_ROOT=$PWD CODEX_STORAGE_ROOT=$ux_test_root node --test /tmp/code-ai-codex-ux-mode.test.mjs",
    "test:ux-mode:visual": ".venv/bin/python scripts/ux-mode-visual-e2e.py",
    "test:ux-mode:gemini": "esbuild scripts/ux-mode-gemini-smoke.ts --bundle --platform=node --format=esm --outfile=/tmp/code-ai-ux-mode-gemini-smoke.mjs && CODEX_APP_ROOT=$PWD node /tmp/code-ai-ux-mode-gemini-smoke.mjs",
    "test:project-mode": "project_test_root=$(mktemp -d /tmp/code-ai-project-mode-test-XXXXXX) && esbuild client/src/components/codex/projectModeConfig.test.ts --bundle --platform=node --format=cjs --outfile=$project_test_root/config.test.cjs && node --test $project_test_root/config.test.cjs && esbuild server/codexProjectMode.test.ts --bundle --platform=node --format=esm --outfile=$project_test_root/server.test.mjs && CODEX_APP_ROOT=$PWD CODEX_STORAGE_ROOT=$project_test_root node --test $project_test_root/server.test.mjs",
    "test:queue-stop-policy": "esbuild server/codexQueueStopPolicy.test.ts --bundle --platform=node --format=esm --outfile=/tmp/code-ai-codex-queue-stop-policy.test.mjs && node --test /tmp/code-ai-codex-queue-stop-policy.test.mjs",
    "test:queue-stop": "queue_test_root=$(mktemp -d /tmp/code-ai-queue-stop-test-XXXXXX) && esbuild server/codexQueue.stopSchedule.test.ts --bundle --platform=node --format=esm --outfile=/tmp/code-ai-codex-queue-stop-schedule.test.mjs --external:node-pty && CODEX_STORAGE_ROOT=$queue_test_root CODEX_QUEUE_DISABLE_EXECUTION=1 node --test /tmp/code-ai-codex-queue-stop-schedule.test.mjs",
    "test:queue-persistence": "esbuild server/codexQueue.persistence.test.ts --bundle --platform=node --format=esm --outfile=/tmp/code-ai-codex-queue-persistence.test.mjs --external:node-pty && node --test /tmp/code-ai-codex-queue-persistence.test.mjs",
    "test:queue-notifications": "queue_notification_root=$(mktemp -d /tmp/code-ai-queue-notifications-XXXXXX) && esbuild server/codexQueueNotifications.test.ts --bundle --platform=node --format=esm --outfile=$queue_notification_root/test.mjs --external:node-pty && CODEX_STORAGE_ROOT=$queue_notification_root CODEX_QUEUE_DISABLE_EXECUTION=1 node --test $queue_notification_root/test.mjs",
    "test:queue-workspace-list": "queue_list_test_root=$(mktemp -d /tmp/code-ai-queue-list-test-XXXXXX) && esbuild server/codexQueueWorkspaceList.test.ts --bundle --platform=node --format=esm --outfile=$queue_list_test_root/test.mjs --external:node-pty && CODEX_QUEUE_DISABLE_EXECUTION=1 node --test $queue_list_test_root/test.mjs",
    "test:word-export": "esbuild server/codexWordExport.test.ts --bundle --platform=node --format=esm --outfile=/tmp/code-ai-codex-word-export.test.mjs && node --test /tmp/code-ai-codex-word-export.test.mjs",
    "test:conversation-share": "esbuild server/codexConversationShare.test.ts --bundle --platform=node --format=esm --outfile=/tmp/code-ai-codex-conversation-share.test.mjs && node --test /tmp/code-ai-codex-conversation-share.test.mjs",
    "test:conversation-search-mode": "conversation_search_test_root=$(mktemp -d /tmp/code-ai-conversation-search-test-XXXXXX) && esbuild server/codexConversationSearchMode.test.ts --bundle --platform=node --format=esm --outfile=$conversation_search_test_root/test.mjs && CODEX_APP_ROOT=$PWD CODEX_STORAGE_ROOT=$conversation_search_test_root node --test $conversation_search_test_root/test.mjs",
    "test:final-notifications": "notification_test_root=$(mktemp -d /tmp/code-ai-final-notification-test-XXXXXX) && esbuild server/codexFinalNotifications.test.ts --bundle --platform=node --format=esm --outfile=/tmp/code-ai-codex-final-notifications.test.mjs && CODEX_STORAGE_ROOT=$notification_test_root node --test /tmp/code-ai-codex-final-notifications.test.mjs",
    "test:terminal": "esbuild server/codexTerminal.test.ts --bundle --platform=node --format=esm --outfile=.code-ai/tmp/code-ai-codex-terminal.test.mjs --external:node-pty && node --test .code-ai/tmp/code-ai-codex-terminal.test.mjs",
    "test:remote-hosts": "esbuild server/remoteHostRegistry.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/code-ai-remote-hosts.test.cjs && node --test /tmp/code-ai-remote-hosts.test.cjs",
    "test:runtime-hardening": "runtime_test_root=$(mktemp -d /tmp/code-ai-runtime-hardening-XXXXXX) && trap 'find \"$runtime_test_root\" -depth -delete' EXIT && esbuild server/codexCrashLogs.test.ts --bundle --platform=node --format=esm --outfile=$runtime_test_root/crash-logs.test.mjs && node --test $runtime_test_root/crash-logs.test.mjs && node --test scripts/code-ai-pm2-entrypoint.test.mjs",
    "test:personal-tunnel": "node --test scripts/personal-computer-tunnel.test.mjs",
    "test:personal-chrome:protocol": "esbuild server/personalChromeProtocol.test.ts --bundle --platform=node --format=esm --outfile=/tmp/code-ai-personal-chrome-protocol.test.mjs && node --test /tmp/code-ai-personal-chrome-protocol.test.mjs",
    "test:personal-chrome:selection": "esbuild client/src/components/codex/browserSelectionContext.test.ts --bundle --platform=node --format=esm --outfile=/tmp/code-ai-personal-chrome-selection.test.mjs && node --test /tmp/code-ai-personal-chrome-selection.test.mjs",
    "test:personal-chrome:mode": "personal_chrome_test_root=$(mktemp -d /tmp/code-ai-personal-chrome-mode-test-XXXXXX) && esbuild server/codexPersonalChromeMode.test.ts --bundle --platform=node --format=esm --outfile=/tmp/code-ai-personal-chrome-mode.test.mjs && CODEX_APP_ROOT=$PWD CODEX_STORAGE_ROOT=$personal_chrome_test_root node --test /tmp/code-ai-personal-chrome-mode.test.mjs",
    "test:phone-mode": "phone_test_root=$(mktemp -d /tmp/code-ai-phone-mode-test-XXXXXX) && esbuild server/codexPhoneMode.test.ts --bundle --platform=node --format=esm --outfile=$phone_test_root/test.mjs && CODEX_APP_ROOT=$PWD CODEX_STORAGE_ROOT=$phone_test_root CODE_AI_REAPRE_API_KEY=rpr_test_phone_mode_key node --test $phone_test_root/test.mjs && node --test server/phone-mode/phone_mode_mcp_server.test.mjs",
    "test:personal-chrome:mcp": "node --test scripts/personal-chrome-mcp.test.mjs",
    "test:personal-chrome:extension": "node --test scripts/personal-chrome-extension.test.mjs",
    "test:personal-chrome:bridge:e2e": "node scripts/personal-chrome-bridge-e2e.mjs",
    "test:personal-chrome:chromium:e2e": "xvfb-run -a .venv/bin/python scripts/personal-chrome-extension-e2e.py",
    "test:personal-chrome:port:e2e": "personal_port_test_root=$(mktemp -d /tmp/code-ai-personal-port-test-XXXXXX) && esbuild server/personalPortForwardBroker.e2e.test.ts --bundle --platform=node --format=esm --outfile=/tmp/code-ai-personal-port-forward.test.mjs && CODEX_STORAGE_ROOT=$personal_port_test_root node --test /tmp/code-ai-personal-port-forward.test.mjs",
    "test:personal-chrome:port:remote:e2e": "personal_port_test_root=$(mktemp -d /tmp/code-ai-personal-remote-port-test-XXXXXX) && esbuild server/personalPortForwardBroker.remote.e2e.test.ts --bundle --platform=node --format=esm --outfile=/tmp/code-ai-personal-remote-port-forward.test.mjs && CODEX_STORAGE_ROOT=$personal_port_test_root CODEX_REMOTE_HOSTS_FILE=$PWD/.code-ai/remote-hosts.json node --test /tmp/code-ai-personal-remote-port-forward.test.mjs",
    "test:personal-chrome:ui:e2e": "xvfb-run -a .venv/bin/python scripts/personal-chrome-ui-e2e.py",
    "test:personal-chrome": "npm run test:personal-chrome:protocol && npm run test:personal-chrome:selection && npm run test:personal-chrome:mode && npm run test:personal-chrome:mcp && npm run test:personal-chrome:extension",
    "extension:package": "node scripts/package-personal-chrome-extension.mjs",
    "remote:deploy": "node scripts/remote-host-deploy.mjs",
    "remote:pair-personal": "node scripts/register-personal-computer.mjs",
    "remote:personal-agent": "node scripts/personal-computer-agent.mjs",
    "preview": "vite preview",
    "start": "node dist/server.js",
    "deploy:install": "node deploy/code-ai/install.mjs",
    "export:standalone": "node deploy/code-ai/export-standalone.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.1.5",
    "@types/express-session": "^1.18.2",
    "@types/pg": "^8.16.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "express": "^4.22.2",
    "express-session": "^1.19.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.460.0",
    "multer": "^2.2.0",
    "node-pty": "^1.1.0",
    "pg": "^8.18.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.5",
    "ws": "^8.21.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
