{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": { "@original/*": ["./client/src/*", "../client/src/*"], "@/*": ["./client/src/*", "../client/src/*"] },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "types": ["vite/client", "node"]
  },
  "include": ["preview-main.tsx", "previewApi.ts", "vite.config.ts"]
}
